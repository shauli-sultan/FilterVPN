# Tier 1 (Basic) — port 5351. Blocks only porn/adult + phishing/malware. Everything else open. Upstream: adult-filter-dns.cleanbrowsing.org
.:5351 {
  errors
  log
  import /opt/filtervpn/coredns/blocklists/block-porn.conf
  import /opt/filtervpn/coredns/blocklists/block-malware.conf
  cache 60
  forward . 185.228.168.10 185.228.169.11 {
    max_concurrent 1000
  }
}
