$ORIGIN social.local.
@   IN SOA ns1.admin. admin. (1 7200 3600 1209600 60)
    IN NS  localhost.
; NXDOMAIN-style sink: resolve social domains to 0.0.0.0 (client drop).
; Full NXDOMAIN needs template plugin; 0.0.0.0 + FORWARD DROP is equivalent here.
tiktok.com            IN A 0.0.0.0
*.tiktok.com          IN A 0.0.0.0
instagram.com         IN A 0.0.0.0
*.instagram.com       IN A 0.0.0.0
facebook.com          IN A 0.0.0.0
*.facebook.com        IN A 0.0.0.0
reddit.com            IN A 0.0.0.0
*.reddit.com          IN A 0.0.0.0
twitter.com           IN A 0.0.0.0
*.twitter.com         IN A 0.0.0.0
x.com                 IN A 0.0.0.0
snapchat.com          IN A 0.0.0.0
