[Unit]
Description=FilterVPN Hebrew block page (:80 on VPN server IP)
After=network-online.target wg-quick@wg0.service
Wants=network-online.target

[Service]
ExecStart=/usr/bin/python3 /opt/filtervpn/blockpage/server.py
Environment=BLOCK_HOST=10.100.0.1 BLOCK_PORT=80
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
