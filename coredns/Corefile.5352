# Tier 2 (Standard) — port 5352. Same as Tier 1 (proxy handles content layer).
.:5352 {
  errors
  log
  cache 60
  file /opt/filtervpn/coredns/blocklists/malware.db malware.local
  file /opt/filtervpn/coredns/blocklists/adult.db adult.local
  forward . 1.1.1.1 8.8.8.8 {
    max_concurrent 1000
  }
}
