# Tier 4 (Full/Max Block) — port 5354. Comprehensive social + distractions + YouTube Restricted + Tier1. Upstream: family-filter-dns.cleanbrowsing.org
.:5354 {
  errors
  log
  import /opt/filtervpn/coredns/blocklists/block-porn.conf
  import /opt/filtervpn/coredns/blocklists/block-malware.conf
  import /opt/filtervpn/coredns/blocklists/block-social-strict.conf
  import /opt/filtervpn/coredns/safesearch.conf
  cache 60
  rewrite name exact www.youtube.com restrict.youtube.com answer auto
  rewrite name exact m.youtube.com restrict.youtube.com answer auto
  rewrite name exact youtubei.googleapis.com restrict.youtube.com answer auto
  rewrite name exact youtube.googleapis.com restrict.youtube.com answer auto
  rewrite name exact www.youtube-nocookie.com restrict.youtube.com answer auto
  forward . 185.228.168.168 185.228.169.168 {
    max_concurrent 1000
  }
}
